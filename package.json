{
  "name": "omniqa-playwright-framework",
  "version": "1.0.0",
  "description": "OmniQA — Enterprise Playwright Automation Framework (UI · API · DB · E2E · BDD · Accessibility · Visual · Performance · Network · CI/CD).",
  "keywords": [
    "omniqa",
    "playwright",
    "typescript",
    "test-automation",
    "page-object-model",
    "api-testing",
    "database-testing",
    "bdd",
    "cucumber",
    "accessibility",
    "visual-regression",
    "performance",
    "ci-cd"
  ],
  "author": "QA Automation Architecture Team",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/omiinayak25/omniqa-playwright-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omiinayak25/omniqa-playwright-framework.git"
  },
  "bugs": {
    "url": "https://github.com/omiinayak25/omniqa-playwright-framework/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "type": "commonjs",
  "scripts": {
    "//--- TEST EXECUTION ---": "",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:db": "playwright test tests/db",
    "db:schema": "ts-node scripts/db/apply-schema.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/accessibility",
    "test:visual": "playwright test tests/visual",
    "test:perf": "playwright test tests/performance",
    "test:network": "playwright test --project=network",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test",
    "test:parallel": "playwright test --workers=4",
    "//--- ENVIRONMENT TARGETED ---": "",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:qa": "cross-env TEST_ENV=qa playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "//--- BDD (CUCUMBER) ---": "",
    "test:bdd": "cucumber-js",
    "test:bdd:smoke": "cucumber-js --tags @smoke",
    "//--- CATALOG ---": "",
    "catalog:gen": "node scripts/catalog/generate-catalog.cjs",
    "//--- REPORTING ---": "",
    "report:html": "playwright show-report reports/html-report",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "//--- CODE QUALITY ---": "",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run format:check",
    "coverage": "c8 playwright test",
    "deps:check": "depcheck --skip-missing",
    "audit:security": "npm audit --audit-level=high",
    "//--- DOCKER ---": "",
    "docker:build": "docker compose build",
    "docker:db": "docker compose up -d postgres",
    "docker:test": "docker compose up --build --abort-on-container-exit --exit-code-from tests",
    "docker:down": "docker compose down -v",
    "//--- SETUP / HOUSEKEEPING ---": "",
    "install:browsers": "playwright install --with-deps",
    "clean": "rimraf reports screenshots videos traces logs downloads test-results playwright-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "allure-js-commons": "^3.10.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cucumber/cucumber": "^11.2.0",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "axe-core": "^4.12.1",
    "c8": "^10.1.3",
    "chrome-launcher": "^1.1.2",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.10.4",
    "exceljs": "^4.4.0",
    "husky": "^9.1.7",
    "lighthouse": "^12.2.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
