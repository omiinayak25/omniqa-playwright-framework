# =====================================================================
#  ENVIRONMENT TEMPLATE  —  copy to `.env` and fill real values
#  `.env` is git-ignored. NEVER commit real credentials.
#  Select active environment with TEST_ENV (dev | qa | uat | staging | production)
# =====================================================================

# ---- Active environment selector ----
TEST_ENV=qa

# ---- UI Application Base URLs ----
SAUCEDEMO_URL=https://www.saucedemo.com
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com

# ---- API Base URLs ----
RESTFUL_BOOKER_URL=https://restful-booker.herokuapp.com
REQRES_URL=https://reqres.in/api
DUMMYJSON_URL=https://dummyjson.com
JSONPLACEHOLDER_URL=https://jsonplaceholder.typicode.com
PETSTORE_URL=https://petstore.swagger.io/v2

# ---- API Keys (where required) ----
REQRES_API_KEY=reqres-free-v1

# ---- UI Test Credentials (demo apps — public) ----
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# ---- Restful Booker auth (demo) ----
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=automation_db
DB_USER=automation_user
DB_PASSWORD=changeme
DB_SCHEMA=public
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_SSL=false

# ---- Execution tuning ----
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=10000
RETRIES=1
WORKERS=4
LOG_LEVEL=info

# ---- Visual regression (screenshot) defaults ----
VISUAL_MAX_DIFF_PIXEL_RATIO=0.02
VISUAL_THRESHOLD=0.2
VISUAL_ANIMATIONS=disabled
VISUAL_FULL_PAGE=true

# ---- Performance smoke budgets ----
PERF_MAX_LOAD_MS=5000
PERF_MAX_DCL_MS=4000
PERF_MAX_TTFB_MS=1500
PERF_MAX_FCP_MS=3000
PERF_MAX_LCP_MS=4000
PERF_MAX_TRANSFER_KB=2048
PERF_MAX_RESOURCES=100
LIGHTHOUSE_ENABLED=false
LIGHTHOUSE_MIN_PERF_SCORE=0.5

# ---- Secrets / crypto ----
ENCRYPTION_SECRET=change-me-in-ci
