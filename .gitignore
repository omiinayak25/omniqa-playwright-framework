# ---- Dependencies ----
node_modules/
.pnp/
.pnp.js

# ---- Build output ----
dist/
build/
*.tsbuildinfo

# ---- Environment & secrets ----
# This is a PUBLIC DEMO repository with NO real secrets. Everything — .env,
# .env.local, any keys/certs, and the .auth/ session storage — is intentionally
# COMMITTED so the project runs anywhere immediately after `git clone`.
# WARNING: if you ever introduce REAL credentials, re-add ignore rules here
# (e.g. .env.local, *.pem, *.key, .auth/) so they are NEVER pushed.

